model User {
  id String @id @default(uuid())

  email        String @unique
  passwordHash String

  name     String?
  photoUrl String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  chats     ChatParticipant[]
  messages  Message[]
  seen      MessageSeen[]
  reactions MessageReaction[]

  @@map("users")
}
