model Message {
  id        String            @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  chatId    String            @db.ObjectId
  chat      Chat              @relation(fields: [chatId], references: [id], onDelete: Cascade)
  senderId  String            @db.ObjectId
  sender    User              @relation(fields: [senderId], references: [id], onDelete: Cascade)
  type      EMessageType      @default(TEXT)
  content   String?
  history   TMessageHistory[]
  readBy    String[]          @default([]) @db.ObjectId
  reacts    Json?
  replyToId String?           @db.ObjectId
  replyTo   Message?          @relation("MessageReplies", fields: [replyToId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies   Message[]         @relation("MessageReplies")

  @@map("messages")
}

type TMessageHistory {
  content String
  time    DateTime
}

enum EMessageType {
  TEXT
  IMAGE
  VIDEO
  AUDIO
  FILE
}
